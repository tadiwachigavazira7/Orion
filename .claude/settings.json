{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "MultiEdit",
      "Glob",
      "LS",
      "Grep",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm run test)",
      "Bash(npm run format)"
    ]
  },

  "hooks": {

    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "echo '=== Orion Development Session ==='"
          },
          {
            "type": "command",
            "command": "echo 'React + TypeScript + Supabase + Stripe'"
          }
        ]
      }
    ],

    "PreToolUse": [

      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Reviewing edit...'"
          }
        ]
      }

    ],

    "PostToolUse": [

      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "npm run format || true"
          }
        ]
      }

    ],

    "Stop": [

      {
        "hooks": [

          {
            "type": "command",
            "command": "npm run typecheck"
          },

          {
            "type": "command",
            "command": "npm run lint"
          },

          {
            "type": "command",
            "command": "npm test -- --runInBand || true"
          }

        ]
      }

    ]

  }
}