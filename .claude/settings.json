{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "MultiEdit",
      "Glob",
      "LS",
      "Grep",
      "Bash(./gradlew test)",
      "Bash(./gradlew assembleDebug)",
      "Bash(./gradlew --quiet test)",
      "Bash(uv run pytest *)"
    ]
  },

  "hooks": {

    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "echo '=== Orion Development Session ==='"
          },
          {
            "type": "command",
            "command": "echo 'Kotlin/Android (Compose) + FastAPI enrollment backend (PostgreSQL) - see CLAUDE.md'"
          }
        ]
      }
    ],

    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-checks.sh\"",
            "timeout": 600,
            "statusMessage": "Running tests for changed code..."
          }
        ]
      }
    ]

  }
}
