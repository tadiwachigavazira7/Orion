<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup and device-transfer rules for Android 12+ (android:dataExtractionRules).
  Same exclusions and rationale as backup_rules.xml: the Keystore-wrapped enrollment
  keyset and the encrypted enrollment record must never be restored to another
  install or device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/" />
        <exclude domain="sharedpref" path="orion_enrollment_keyset_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/" />
        <exclude domain="sharedpref" path="orion_enrollment_keyset_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
