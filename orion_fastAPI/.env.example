# Copy to .env and fill in for local development. Never commit a real .env.

# Async SQLAlchemy connection string (asyncpg driver).
DATABASE_URL=postgresql+asyncpg://orion:orion@localhost:5432/orion

# Comma-separated list of allowed CORS origins. Empty by default (deny all).
# Example: https://admin.example-retailer.com,https://another-tool.internal
CORS_ORIGINS=

# REQUIRED. Gates Orion's internal /admin/* endpoints (provisioning and device
# management). The app refuses to start without it. Must be at least 16
# characters; uncomment and set it, use a long random secret and never commit a real value.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# ADMIN_API_KEY=<paste generated secret here>
