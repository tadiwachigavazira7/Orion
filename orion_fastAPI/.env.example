# Copy to .env and fill in for local development. Never commit a real .env.

# Async SQLAlchemy connection string (asyncpg driver). Used by the API,
# Alembic, the operator CLI (python -m orion_backend.cli), and the seed script.
DATABASE_URL=postgresql+asyncpg://orion:orion@localhost:5432/orion

# development | test | production. Has no default on purpose, and is left
# unset here on purpose: scripts/seed_dev_data.py refuses to run unless this
# is explicitly "development", and that opt-in should be a deliberate act
# per command, not something inherited from copying this file. Prefer:
#   ORION_ENVIRONMENT=development uv run python scripts/seed_dev_data.py
# ORION_ENVIRONMENT=

# Comma-separated list of explicitly allowed CORS origins. Empty by default
# (deny all browser origins); "*" is rejected. CORS is not authentication -
# the Android app does not need any origin listed here.
# Example: https://admin.example-retailer.com,https://another-tool.internal
CORS_ORIGINS=

# How long a device may run Orion without reaching the verify endpoint.
# Returned by the server as offline_valid_until = server_time + this many hours.
OFFLINE_AUTHORIZATION_HOURS=24

# Lifetime of an operator-issued enrollment authorization (single use).
# An implementation default, not an approved business requirement.
ENROLLMENT_AUTHORIZATION_TTL_MINUTES=30
